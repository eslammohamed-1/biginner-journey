---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import ExerciseSection from './exercises/ExerciseSection';
import BookProgress from './BookProgress';
import { loadCatalog } from '../lib/catalog';

const { id } = Astro.locals.starlightRoute;
const catalog = await loadCatalog();
const chapterMatch = id.match(/^(?<book>\d{2}-[a-z0-9-]+)\/(?<file>ch\d+)$/);
const bookMatch = id.match(/^(?<book>\d{2}-[a-z0-9-]+)$/);

const chapterKey = chapterMatch?.groups
	? `${chapterMatch.groups.book}/${chapterMatch.groups.file}`
	: undefined;
const exerciseData = chapterKey ? catalog.byKey.get(chapterKey) : undefined;
const bookEntry = bookMatch?.groups
	? catalog.books.find((book) => book.slug === bookMatch.groups!.book)
	: undefined;

const chapterBook = chapterMatch?.groups
	? catalog.books.find((book) => book.slug === chapterMatch.groups!.book)
	: undefined;
const lastVisited = chapterMatch
	? {
			href: Astro.url.pathname,
			title: Astro.locals.starlightRoute.entry.data.title,
			bookTitle: chapterBook?.title ?? '',
		}
	: null;

const chapterTotals: Record<string, number> = {};
for (const book of catalog.books) {
	for (const ch of book.chapters) {
		chapterTotals[`${book.slug}/${ch.file}`] = ch.ids.length;
	}
}
---

{
	bookEntry && (
		<BookProgress
			client:load
			slug={bookEntry.slug}
			title={bookEntry.title}
			chapters={bookEntry.chapters}
		/>
	)
}
<div class:list={['bj-doc-body', { 'is-book-index': Boolean(bookEntry), 'is-chapter-page': Boolean(chapterMatch) }]}>
	<Default><slot /></Default>
</div>
{
	exerciseData && (
		<>
			<ExerciseSection client:visible={{ rootMargin: '600px' }} data={exerciseData} />
			<noscript>
				<p class="ex-noscript">التصحيح وحفظ النتيجة محتاجين JavaScript.</p>
			</noscript>
		</>
	)
}
{
	chapterMatch && !exerciseData && (
		<section class="ex-soon" aria-label="اتدرّب">
			<h2>اتدرّب</h2>
			<p>التمارين جاية قريب</p>
		</section>
	)
}
{
	lastVisited && (
		<script is:inline define:vars={{ lastVisited }}>
			try {
				localStorage.setItem('bj-last-v1', JSON.stringify(lastVisited));
			} catch {}
		</script>
	)
}
<script is:inline define:vars={{ chapterTotals }}>
	function enhanceDocumentVisuals() {
		const content = document.querySelector('.bj-doc-body .sl-markdown-content');
		if (!content) return;

		// 1. Style "تشريح الأمر" blocks and their numbered breakdown lists
		content.querySelectorAll('p > strong:only-child').forEach((strong) => {
			const txt = (strong.textContent || '').trim();
			const parentP = strong.parentElement;
			if (!parentP) return;
			if (txt === 'تشريح الأمر') {
				parentP.classList.add('cmd-anatomy-label');
				let next = parentP.nextElementSibling;
				if (next && (next.classList.contains('expressive-code') || next.tagName === 'PRE' || next.tagName === 'FIGURE')) {
					next.classList.add('cmd-anatomy-code');
					const list = next.nextElementSibling;
					if (list && list.tagName === 'OL') {
						list.classList.add('cmd-anatomy-steps');
					}
				}
			} else if (parentP.nextElementSibling && parentP.nextElementSibling.tagName === 'TABLE') {
				parentP.classList.add('table-caption-title');
			}
		});

		// 2. Style cross-reference chips [↩ ...]
		content.querySelectorAll('a[href]').forEach((a) => {
			const text = (a.textContent || '').trim();
			if (text.startsWith('↩')) {
				a.classList.add('xref-chip');
			}
		});

		// 3. Style end-of-chapter review headings ("صح ولا غلط؟", "أسئلة مراجعة", "تحديات الفصل")
		content.querySelectorAll('h3').forEach((h3) => {
			const title = (h3.textContent || '').trim();
			if (title === 'صح ولا غلط؟' || title === 'أسئلة مراجعة' || title === 'تحديات الفصل') {
				h3.classList.add('chapter-end-heading');
				if (title === 'تحديات الفصل') {
					h3.classList.add('is-challenges-heading');
				}
				let el = h3.nextElementSibling;
				while (el && el.tagName !== 'H3' && el.tagName !== 'H2') {
					if (el.tagName === 'OL' || el.tagName === 'UL') {
						el.classList.add('chapter-end-list');
						if (title === 'تحديات الفصل') {
							el.classList.add('is-challenges-list');
							el.querySelectorAll('li > strong:first-child').forEach((badge) => {
								const bText = (badge.textContent || '').trim();
								if (bText.includes('سهل')) badge.classList.add('ch-lvl-badge', 'is-easy');
								else if (bText.includes('متوسط')) badge.classList.add('ch-lvl-badge', 'is-medium');
								else if (bText.includes('صعب')) badge.classList.add('ch-lvl-badge', 'is-hard');
							});
						}
					}
					el = el.nextElementSibling;
				}
			}
		});
	}

	function decorateSidebarAndReview() {
		try {
			const raw = localStorage.getItem('bj-progress-v1');
			const store = raw ? JSON.parse(raw) : {};
			const sidebarLinks = document.querySelectorAll('nav.sidebar a[href], .sidebar-content a[href]');
			sidebarLinks.forEach((link) => {
				const href = link.getAttribute('href') || '';
				const m = href.match(/\/(\d{2}-[a-z0-9-]+)\/(ch\d+)\/?$/);
				if (!m) return;
				const key = m[1] + '/' + m[2];
				const total = chapterTotals[key] || 0;
				if (!total) return;
				const items = (store[key] && store[key].items) || {};
				let solved = 0;
				for (const id in items) {
					if (items[id] && items[id].solved) solved++;
				}
				let badge = link.querySelector('.sb-ch-badge');
				if (solved >= total) {
					if (!badge) {
						badge = document.createElement('span');
						badge.className = 'sb-ch-badge is-done';
						link.appendChild(badge);
					}
					badge.className = 'sb-ch-badge is-done';
					badge.textContent = '✓';
					badge.title = 'مكتمل (' + solved + '/' + total + ')';
				} else if (solved > 0) {
					if (!badge) {
						badge = document.createElement('span');
						badge.className = 'sb-ch-badge is-part';
						link.appendChild(badge);
					}
					badge.className = 'sb-ch-badge is-part';
					badge.textContent = solved + '/' + total;
				} else if (badge) {
					badge.remove();
				}
			});
		} catch {}
	}

	enhanceDocumentVisuals();
	decorateSidebarAndReview();
	window.addEventListener('bj-progress', decorateSidebarAndReview);
	window.addEventListener('storage', decorateSidebarAndReview);
</script>
