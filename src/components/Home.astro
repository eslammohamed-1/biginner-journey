---
import HomeGrid from './HomeGrid';
import ResumeLink from './ResumeLink';
import ProgressTools from './ProgressTools';
import { loadCatalog } from '../lib/catalog';

const { books } = await loadCatalog();
const base = import.meta.env.BASE_URL;
---

<div class="home-intro">
	<div class="home-hero-badge">مسار تأسيسي تفاعلي بالعربية · 8 كتب · 175 فصلاً · 2,069 تمريناً</div>
	<p class="home-tagline">كتب المسارات الجانبية — افهم اللي بيحصل تحت الغطاء وجرّب بإيدك</p>
	<p class="study-order">
		<strong>الترتيب مهم:</strong> ابدأ من الكتاب <strong>01 (الـ Terminal)</strong> وكمّل بالترتيب لحد <strong>08 (Kubernetes)</strong>، لأن كل كتاب بيبني على المفاهيم والأدوات اللي اتعلمتها في اللي قبله.
	</p>
	<div class="home-cta-row">
		<ResumeLink client:load base={base} />
	</div>
</div>
<HomeGrid
	client:load
	base={base}
	books={books.map((book) => ({
		number: book.number,
		slug: book.slug,
		title: book.title,
		subtitle: book.subtitle,
		description: book.description,
		chapters: book.chapters,
	}))}
/>
<ProgressTools client:idle />
